{
  "name": "darklord-bot",
  "version": "0.1.2",
  "private": true,
  "description": "DarkLord Bot 本機遊戲自動化與模組分析工具",
  "author": "DarkLord Bot",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node --test tests/*.test.cjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis portable --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.darklord.bot",
    "productName": "DarkLord Bot",
    "artifactName": "DarkLord-Bot-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DarkLord Bot"
    },
    "portable": {
      "artifactName": "DarkLord-Bot-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  }
}
